{
  "name": "local notebook",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de estudos para certificacoes de IA com RAG local, tutoria, quizzes e simulados.",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "tsx --test test/smoke.test.ts",
    "ingest": "tsx src/cli.ts ingest",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.2.1",
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
